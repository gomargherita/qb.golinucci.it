APP_NAME=QB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qb
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_BCC_TO=
MAIL_ON_FAILURE=
MAIL_TEST_TO=
POSTMARK_TOKEN=
PW_PEC=

PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_PAYMENT_ACTION=Sale
PAYPAL_CURRENCY=EUR
PAYPAL_LOCALE=it_IT
PAYPAL_VALIDATE_SSL=true
PAYPAL_NOTIFY_URL=
# URL webhook da registrare in PayPal Developer: https://<host>/paypal/webhook
# PAYPAL_WEBHOOK_ID=

DOPRINT_MODE=sandbox
DOPRINT_SANDBOX_API_KEY=
DOPRINT_SANDBOX_WSDL=
DOPRINT_SANDBOX_REQUESTOR_ID=
DOPRINT_LIVE_API_KEY=
DOPRINT_LIVE_WSDL=
DOPRINT_LIVE_REQUESTOR_ID=

YOUSIGN_KEY=
YOUSIGN_API_URL=https://api.yousign.app/v3/
YOUSIGN_APP_URL=https://staging-app.yousign.com/
YOUSIGN_STAGING_EMAIL=
YOUSIGN_STAGING_CELLPHONE=
YOUSIGN_CUSTOM_EXPERIENCE=
# Opzionale: se valorizzato, i webhook richiedono header X-Yousign-Webhook-Secret
YOUSIGN_WEBHOOK_SECRET=

# KAN-4: TTL (giorni) del token opaco nei link email di rinnovo
RENEWAL_ACCESS_TOKEN_TTL_DAYS=30
# KAN-8: OTP email dopo il click sul link
RENEWAL_OTP_TTL_MINUTES=60
RENEWAL_OTP_LENGTH=6
RENEWAL_OTP_MAX_ATTEMPTS=5
RENEWAL_OTP_RESEND_SECONDS=60
